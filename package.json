{
  "name": "@point-of-sale/capacitor-epson-epos-receipt-printer",
  "version": "0.0.1",
  "type": "module",
  "description": "Capacitor plugin for Epson receipt printers via the ePOS2 SDK — a raw ESC/POS (addCommand/sendData) transport over LAN, Bluetooth (MFi/SPP), BLE and USB",
  "exports": {
    ".": {
      "import": "./dist/capacitor-epson-epos-receipt-printer.esm.js",
      "require": "./dist/capacitor-epson-epos-receipt-printer.umd.js"
    }
  },
  "module": "dist/capacitor-epson-epos-receipt-printer.esm.js",
  "main": "dist/capacitor-epson-epos-receipt-printer.umd.js",
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "keywords": [
    "capacitor",
    "epson",
    "epos",
    "epos2",
    "receipt",
    "receiptprinter",
    "escpos",
    "tm-m30",
    "mfi"
  ],
  "author": "Niels Leenheer",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^24.1.0",
    "@rollup/plugin-node-resolve": "^15.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^3.20.7"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "PointOfSaleCapacitorEpsonEposReceiptPrinter.podspec",
    "EPSON-EULA.en.txt",
    "!android/build",
    "!android/.gradle",
    "!ios/build",
    "!ios/Pods"
  ],
  "publishConfig": {
    "access": "public"
  }
}
